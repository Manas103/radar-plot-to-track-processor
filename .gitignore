# Build outputs. Regenerate with:
#   cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j2
build/
build-*/
out/
*.o
*.obj
*.exe
*.a
*.so
*.dylib
CMakeFiles/
CMakeCache.txt
compile_commands.json

# GoogleTest is fetched by CMake FetchContent at configure time, never
# vendored. Regenerates automatically on the next `cmake -S . -B build`.
_deps/

# Python
__pycache__/
*.pyc
venv/
venv_linux/
.venv/
.pytest_cache/

# maneuver_search's 220,000-segment mining corpus and mined events are
# large, regenerable simulation output, not source. Regenerate with:
#   ./build/autolabel_cli mine-corpus /tmp/corpus.tsv /tmp/events.tsv 220000 1
maneuver_search/*.tsv

# IDE / editor
.vscode/
.idea/
*.swp

# Recorded scan logs and scenario batches are large, regenerable simulation
# output, not source. Regenerate with:
#   ./build/radar_cli record docs_data/session.log <num_scans>
#   python3 python_reference/generate_scenarios.py --out scenarios/
*.scanlog
scenarios/
docs_data/

# Loaded SQLite databases are regenerable from docs/sample_events.tsv (or
# any autolabel_cli mine output). Regenerate with:
#   python3 python_reference/events_to_sqlite.py docs/sample_events.tsv docs/sample_events.sqlite3
*.sqlite3
